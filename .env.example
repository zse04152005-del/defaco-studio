# Copy to .env and fill in. .env is git-ignored -- never commit it.

# ---- AI research assistant: any OpenAI-compatible chat-completions API with tool calling ----
# LLM_PROVIDER: deepseek | openai | qwen | moonshot | zhipu | siliconflow | openrouter | ollama | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional: override the provider's default endpoint (required for LLM_PROVIDER=custom), e.g.
#   https://api.openai.com/v1 · https://dashscope.aliyuncs.com/compatible-mode/v1 · http://127.0.0.1:11434/v1
LLM_BASE_URL=
# Model for Q&A and the analysts, and for the report editor (defaults: DeepSeek's models; other providers need LLM_MODEL)
LLM_MODEL=
LLM_MODEL_PRO=
# set to 0 to disable all LLM calls (the rest of the system works without an LLM)
ASSISTANT_ENABLED=1
# (older DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL / DEEPSEEK_MODEL_PRO are still read when LLM_* are empty)

# ---- Alert webhooks (optional; can also be entered on the 监控预警 page, stored in state/monitor.json) ----
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
