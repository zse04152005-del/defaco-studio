# Copy to .env and fill in. .env is git-ignored.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# set to 0 to disable all LLM calls (the assistant then answers from engine data only)
ASSISTANT_ENABLED=1
# Alert webhooks (optional; can also be entered on the 监控预警 page, stored in state/monitor.json)
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
